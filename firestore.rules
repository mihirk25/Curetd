rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasLegalNameFields(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if !hasLegalNameFields(resource.data) || isOwner(userId);
      allow create, update: if isOwner(userId)
        && !hasLegalNameFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['curatorEmail'])
          || !request.resource.data.keys().hasAny(['curatorEmail'])
        );
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['likedAt']);
        allow delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn()
          && (
            resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid
          );
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /savedClips/{id} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && id == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid
        && id == request.resource.data.originalClipId + '_' + request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(resource.data);
      allow update: if isConversationParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
      allow create: if isConversationParticipant(request.resource.data);

      match /messages/{mid} {
        allow read: if isConversationParticipant(conversationData(id));
        allow create: if isConversationParticipant(conversationData(id))
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isConversationParticipant(conversationData(id));
        allow delete: if isConversationParticipant(conversationData(id))
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
