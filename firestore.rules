rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPrivateUserFields(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function publicUserDataIsSafe(data) {
      return !hasPrivateUserFields(data);
    }

    function userWriteIsSafe() {
      return publicUserDataIsSafe(request.resource.data);
    }

    function clipDataIsSafe(data) {
      return !data.keys().hasAny(['curatorEmail']);
    }

    function clipBelongsToSignedInUser(data) {
      return signedIn()
        && data != null
        && data.keys().hasAll(['userId'])
        && data.userId == request.auth.uid;
    }

    function savedClipBelongsToSignedInUser(data) {
      return signedIn()
        && data != null
        && data.keys().hasAll(['userId'])
        && data.userId == request.auth.uid;
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data != null
        && data.keys().hasAll(['participants'])
        && request.auth.uid in data.participants;
    }

    function isExistingConversationParticipant(conversationId) {
      return isConversationParticipant(
        get(/databases/$(database)/documents/conversations/$(conversationId)).data
      );
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if publicUserDataIsSafe(resource.data) || isOwner(userId);
      allow create, update: if isOwner(userId) && userWriteIsSafe();
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if clipBelongsToSignedInUser(request.resource.data)
        && clipDataIsSafe(request.resource.data);
      allow update: if clipBelongsToSignedInUser(resource.data)
        && clipBelongsToSignedInUser(request.resource.data)
        && clipDataIsSafe(request.resource.data);
      allow delete: if clipBelongsToSignedInUser(resource.data);
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{subCollection}/{document=**} {
      allow read: if true;
      allow write: if signedIn() && subCollection != "reactions";
    }

    match /savedClips/{id} {
      allow read, update, delete: if savedClipBelongsToSignedInUser(resource.data);
      allow create: if savedClipBelongsToSignedInUser(request.resource.data);
    }

    match /follows/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(resource.data);
      allow create: if isConversationParticipant(request.resource.data);
      allow update: if isConversationParticipant(resource.data)
        && isConversationParticipant(request.resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isConversationParticipant(resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read, update, delete: if isExistingConversationParticipant(id);
      allow create: if isExistingConversationParticipant(id)
        && request.resource.data.senderId == request.auth.uid;
    }
  }
}
