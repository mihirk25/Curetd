rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function publicUserKeys() {
      return [
        'username',
        'photoURL',
        'profilePhoto',
        'createdAt',
        'hasAddedClip',
        'hasLegalName',
        'profileTopics',
        'hasSeenTopicPrompt',
        'displayName',
        'bio',
        'followerCount'
      ];
    }

    function hasPrivateUserFields(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function hasNoPublicEmail(data) {
      return !data.keys().hasAny(['curatorEmail']);
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function hasParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function ownsClip(clipId) {
      return signedIn()
        && get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    match /users/{userId} {
      allow read: if !hasPrivateUserFields(resource.data) || isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(publicUserKeys());
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && hasNoPublicEmail(request.resource.data);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && hasNoPublicEmail(request.resource.data);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{likeId} {
      allow read: if true;
      allow create, update, delete: if isOwner(likeId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.userId == request.auth.uid || ownsClip(clipId));
    }

    match /clips/{clipId}/{subcollection}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read: if hasParticipant(resource.data);
      allow create: if hasParticipant(request.resource.data);
      allow update: if hasParticipant(resource.data)
        && hasParticipant(request.resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if hasParticipant(resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(id);
      allow create: if isConversationParticipant(id)
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isConversationParticipant(id)
        && (
          resource.data.senderId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
      allow delete: if isConversationParticipant(id)
        && resource.data.senderId == request.auth.uid;
    }
  }
}
