rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasNoPublicPrivateFields(data) {
      return !data.keys().hasAny(['firstName', 'lastName']);
    }

    function participantIn(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function conversationPath(id) {
      return /databases/$(database)/documents/conversations/$(id);
    }

    function currentConversationParticipant(id) {
      return exists(conversationPath(id))
        && participantIn(get(conversationPath(id)).data);
    }

    function nextConversationParticipant(id) {
      return participantIn(getAfter(conversationPath(id)).data);
    }

    function ownsExistingClip() {
      return signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    function ownsRequestedClip() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(['curatorId'])
          || request.resource.data.curatorId == request.auth.uid
        )
        && !request.resource.data.keys().hasAny(['curatorEmail']);
    }

    function onlyUpdatesRepostCount() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount']);
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasNoPublicPrivateFields(resource.data);
      allow create, update: if isOwner(userId)
        && hasNoPublicPrivateFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if ownsRequestedClip();
      allow update: if (ownsExistingClip() && ownsRequestedClip())
        || onlyUpdatesRepostCount();
      allow delete: if ownsExistingClip();
    }

    match /clips/{clipId}/likes/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /conversations/{id} {
      allow read, update, delete: if participantIn(resource.data);
      allow create: if participantIn(request.resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read, update, delete: if currentConversationParticipant(id);
      allow create: if nextConversationParticipant(id)
        && request.resource.data.senderId == request.auth.uid;
    }
  }
}
