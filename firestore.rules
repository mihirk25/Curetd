rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasNoPublicUserSecrets(data) {
      return !data.keys().hasAny(['firstName', 'lastName']);
    }

    function validPrivateUserData(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'updatedAt'])
        && data.firstName is string
        && data.firstName.size() > 0
        && data.lastName is string
        && data.lastName.size() > 0;
    }

    function validClipOwnerData(data) {
      return signedIn()
        && data.userId == request.auth.uid
        && (!data.keys().hasAny(['curatorId']) || data.curatorId == request.auth.uid)
        && !data.keys().hasAny(['curatorEmail']);
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && hasNoPublicUserSecrets(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && validPrivateUserData(request.resource.data);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if validClipOwnerData(request.resource.data);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && (!request.resource.data.keys().hasAny(['curatorId']) || request.resource.data.curatorId == request.auth.uid)
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if signedIn() && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read, write: if signedIn();
    }

    match /follows/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id}/messages/{mid} {
      allow read, write: if signedIn();
    }
  }
}
