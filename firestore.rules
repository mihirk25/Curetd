rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasNoLegalNameFields(data) {
      return !data.keys().hasAny(['firstName', 'lastName']);
    }

    function hasNoPrivateClipFields(data) {
      return !data.keys().hasAny(['curatorEmail']);
    }

    function ownsExistingClip(clipId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clips/$(clipId))
        && get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid;
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if hasNoLegalNameFields(resource.data) || isOwner(userId);
      allow create, update: if isOwner(userId)
        && hasNoLegalNameFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0;
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && hasNoPrivateClipFields(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && hasNoPrivateClipFields(request.resource.data);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || ownsExistingClip(clipId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || ownsExistingClip(clipId));
    }

    match /clips/{clipId}/reactions/{reactionId} {
      allow read, write: if false;
    }

    match /clips/{clipId}/{document=**} {
      allow read, write: if false;
    }

    match /savedClips/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(resource.data);
      allow create: if isConversationParticipant(request.resource.data);
      allow update: if isConversationParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(
        get(/databases/$(database)/documents/conversations/$(id)).data
      );
      allow create: if isConversationParticipant(
        getAfter(/databases/$(database)/documents/conversations/$(id)).data
      )
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isConversationParticipant(
        get(/databases/$(database)/documents/conversations/$(id)).data
      );
      allow delete: if false;
    }
  }
}
