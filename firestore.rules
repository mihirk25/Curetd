rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function publicUserDocHasNoLegalName() {
      return !resource.data.keys().hasAny(['firstName', 'lastName']);
    }

    function publicUserWriteHasNoLegalName() {
      return !request.resource.data.keys().hasAny(['firstName', 'lastName']);
    }

    function validClipOwner(data) {
      return data.userId is string
        && data.userId == request.auth.uid
        && (!('curatorId' in data) || data.curatorId == request.auth.uid);
    }

    function clipWriteDoesNotAddPrivateFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['curatorEmail']);
    }

    function conversationAfterHasParticipant(conversationId) {
      return request.auth.uid in getAfter(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data.participants;
    }

    function conversationHasParticipant(conversationId) {
      return request.auth.uid in get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data.participants;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || publicUserDocHasNoLegalName();
      allow create, update: if isOwner(userId) && publicUserWriteHasNoLegalName();
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && validClipOwner(request.resource.data)
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && validClipOwner(request.resource.data)
        && clipWriteDoesNotAddPrivateFields();
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if signedIn() && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
    }

    match /conversations/{id}/messages/{mid} {
      allow read, update, delete: if signedIn() && conversationHasParticipant(id);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && conversationAfterHasParticipant(id);
    }
  }
}
