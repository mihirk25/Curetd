rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasLegalNameFields(data) {
      return 'firstName' in data || 'lastName' in data;
    }

    function hasNoPublicLegalName(data) {
      return !hasLegalNameFields(data);
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function canAccessConversation(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId))
        && isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        );
    }

    function isClipOwner(clipId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clips/$(clipId))
        && get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasNoPublicLegalName(resource.data);
      allow create, update: if isOwner(userId) && hasNoPublicLegalName(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !('curatorEmail' in request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && !('curatorEmail' in request.resource.data);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{likeUserId} {
      allow read: if true;
      allow create, update, delete: if isOwner(likeUserId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isClipOwner(clipId));
    }

    match /clips/{clipId}/reactions/{reactionId} {
      allow read: if true;
      allow write: if false;
    }

    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(resource.data);
      allow create: if isConversationParticipant(request.resource.data);
      allow update: if isConversationParticipant(resource.data)
        && isConversationParticipant(request.resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isConversationParticipant(resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if canAccessConversation(id);
      allow create: if canAccessConversation(id)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if canAccessConversation(id);
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }
  }
}
