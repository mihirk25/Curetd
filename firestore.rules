rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasNoPublicLegalName(data) {
      return !data.keys().hasAny(['firstName', 'lastName']);
    }

    function userWriteHasNoPublicLegalName() {
      return hasNoPublicLegalName(request.resource.data);
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(conversationPath(conversationId))
        && get(conversationPath(conversationId)).data.participants is list
        && request.auth.uid in get(conversationPath(conversationId)).data.participants;
    }

    function isConversationParticipantAfter(conversationId) {
      return signedIn()
        && existsAfter(conversationPath(conversationId))
        && getAfter(conversationPath(conversationId)).data.participants is list
        && request.auth.uid in getAfter(conversationPath(conversationId)).data.participants;
    }

    function requestIsConversationParticipant() {
      return signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
    }

    function clipPath(clipId) {
      return /databases/$(database)/documents/clips/$(clipId);
    }

    function isClipOwner(clipId) {
      return signedIn()
        && exists(clipPath(clipId))
        && get(clipPath(clipId)).data.userId == request.auth.uid;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasNoPublicLegalName(resource.data);
      allow create, update: if isOwner(userId) && userWriteHasNoPublicLegalName();
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isClipOwner(clipId));
    }

    match /clips/{clipId}/{subcollection}/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(id);
      allow create: if requestIsConversationParticipant();
      allow update: if isConversationParticipant(id)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isConversationParticipant(id);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(id);
      allow create: if isConversationParticipantAfter(id)
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isConversationParticipant(id)
        && request.resource.data.senderId == resource.data.senderId;
      allow delete: if isConversationParticipant(id)
        && resource.data.senderId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
