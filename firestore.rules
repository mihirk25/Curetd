rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasNoPublicPrivateFields(data) {
      return !data.keys().hasAny(['firstName', 'lastName', 'curatorEmail']);
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function parentConversation(id) {
      return get(/databases/$(database)/documents/conversations/$(id));
    }

    function parentClip(clipId) {
      return get(/databases/$(database)/documents/clips/$(clipId));
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasNoPublicPrivateFields(resource.data);
      allow create, update: if isOwner(userId)
        && hasNoPublicPrivateFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && hasNoPublicPrivateFields(request.resource.data);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && hasNoPublicPrivateFields(request.resource.data);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || parentClip(clipId).data.userId == request.auth.uid
        );
    }

    match /clips/{clipId}/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(resource.data);
      allow create: if isConversationParticipant(request.resource.data);
      allow update: if isConversationParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if signedIn()
        && parentConversation(id).data.participants is list
        && request.auth.uid in parentConversation(id).data.participants;
      allow create: if signedIn()
        && parentConversation(id).data.participants is list
        && request.auth.uid in parentConversation(id).data.participants
        && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn()
        && parentConversation(id).data.participants is list
        && request.auth.uid in parentConversation(id).data.participants;
      allow delete: if signedIn()
        && resource.data.senderId == request.auth.uid;
    }
  }
}
