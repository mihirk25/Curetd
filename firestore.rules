rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPrivateLegalNameFields(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function conversationPath(id) {
      return /databases/$(database)/documents/conversations/$(id);
    }

    function clipPath(id) {
      return /databases/$(database)/documents/clips/$(id);
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || !hasPrivateLegalNameFields(resource.data);
      allow create, update: if isOwner(userId)
        && !hasPrivateLegalNameFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && !request.resource.data.diff(resource.data).addedKeys().hasAny(['curatorEmail'])
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['curatorEmail']);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{likeId} {
      allow read: if true;
      allow create, update: if isOwner(likeId);
      allow delete: if isOwner(likeId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || get(clipPath(clipId)).data.userId == request.auth.uid
        );
    }

    match /savedClips/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.clipId is string;
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.clipId is string;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /conversations/{id} {
      allow create: if isConversationParticipant(request.resource.data);
      allow read, update, delete: if isConversationParticipant(resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(get(conversationPath(id)).data);
      allow create: if isConversationParticipant(get(conversationPath(id)).data)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isConversationParticipant(get(conversationPath(id)).data);
    }
  }
}
