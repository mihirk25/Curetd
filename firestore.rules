rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // Username on users/{uid} must match a claimed usernames/{handle} owned by this uid
    // (or remain unchanged). Uses existsAfter/getAfter so claim transactions succeed.
    function usernameConsistent() {
      return !request.resource.data.keys().hasAny(['username'])
        || request.resource.data.username == null
        || (
          resource != null
          && resource.data.keys().hasAny(['username'])
          && request.resource.data.username == resource.data.username
        )
        || (
          request.resource.data.username is string
          && request.resource.data.username.size() >= 3
          && request.resource.data.username.size() <= 20
          && request.resource.data.username.matches('^[a-z0-9_]+$')
          && existsAfter(usernamePath(request.resource.data.username))
          && getAfter(usernamePath(request.resource.data.username)).data.uid == request.auth.uid
        );
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && usernameConsistent();
      allow delete: if false;
    }

    function onlyUpdatesRepostCount() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount']);
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if (
          request.auth != null
          && resource != null
          && resource.data.userId == request.auth.uid
        ) || onlyUpdatesRepostCount();
      allow delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read, write: if request.auth != null;
    }

    match /follows/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id}/messages/{mid} {
      allow read, write: if request.auth != null;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }
  }
}
