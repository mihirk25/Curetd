rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function participantIn(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    // Same membership (order-independent). Blocks ACL expansion/shrink while
    // still allowing benign reorders from create-if-missing merge paths.
    function sameParticipantSet(before, after) {
      return before.participants is list
        && after.participants is list
        && before.participants.size() == after.participants.size()
        && after.participants.hasAll(before.participants);
    }

    function conversationPath(id) {
      return /databases/$(database)/documents/conversations/$(id);
    }

    function currentConversationParticipant(id) {
      return exists(conversationPath(id))
        && participantIn(get(conversationPath(id)).data);
    }

    function nextConversationParticipant(id) {
      return participantIn(getAfter(conversationPath(id)).data);
    }

    function sortedDmId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Deterministic DM ids are sorted `uidA_uidB`. Bind create so a third party
    // cannot pre-create Bob_Charlie with themselves silently included.
    function isValidDmConversationCreate(id) {
      return request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.get('isGroup', false) != true
        && id == sortedDmId(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );
    }

    // Group docs must use a `group_` id prefix so they cannot occupy DM slots.
    function isValidGroupConversationCreate(id) {
      return request.resource.data.get('isGroup', false) == true
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid
        && id.matches('^group_.*');
    }

    function isMessageSender() {
      return signedIn()
        && resource.data.senderId == request.auth.uid;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read, write: if request.auth != null;
    }

    match /follows/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id} {
      allow read, delete: if participantIn(resource.data);
      allow create: if isValidDmConversationCreate(id) || isValidGroupConversationCreate(id);
      // Participants are immutable (set-equality). Prevents inviting a third
      // party into a DM to leak history after participant-only reads land.
      allow update: if participantIn(resource.data)
        && sameParticipantSet(resource.data, request.resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if currentConversationParticipant(id);
      allow create: if nextConversationParticipant(id)
        && request.resource.data.senderId == request.auth.uid;
      // Sender may edit own messages (senderId sticky). Any participant may
      // only flip `read` (mark-as-read). Blocks peer forge/wipe of text.
      allow update: if currentConversationParticipant(id) && (
        (
          isMessageSender()
          && request.resource.data.senderId == resource.data.senderId
        )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if currentConversationParticipant(id) && isMessageSender();
    }

    // Collections: owner-scoped. Bind denormalized username to users/{uid}.username so
    // an attacker cannot create a doc that hijacks /{victim}/collections/{slug}.
    match /collections/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          == request.resource.data.username;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (
          !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']))
          || (
            request.resource.data.username is string
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
              == request.resource.data.username
          )
        );
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Reposts: owner-scoped. Sticky `repostedByUid` + deterministic id
    // (`{originalClipId}_{uid}`) so an author cannot reattribute a repost onto
    // another user's profile (same class as sticky comment/follow authorship).
    match /reposts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid
        && request.resource.data.originalClipId is string
        && request.resource.data.originalClipId.size() > 0
        && id == request.resource.data.originalClipId + '_' + request.auth.uid;
      allow update: if signedIn()
        && resource.data.repostedByUid == request.auth.uid
        && request.resource.data.repostedByUid == resource.data.repostedByUid
        && request.resource.data.originalClipId == resource.data.originalClipId;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }
  }
}
