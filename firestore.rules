rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPublicLegalName(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if !hasPublicLegalName(resource.data) || isSelf(userId);
      allow create, update: if isSelf(userId)
        && !hasPublicLegalName(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['curatorEmail']);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{likeId} {
      allow read: if true;
      allow create, update: if isSelf(likeId)
        && request.resource.data.keys().hasOnly(['likedAt']);
      allow delete: if isSelf(likeId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'username',
          'displayName',
          'photoURL',
          'text',
          'createdAt',
        ]);
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid
        );
    }

    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /conversations/{id} {
      allow read, update, delete: if isConversationParticipant(resource.data);
      allow create: if isConversationParticipant(request.resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(
        get(/databases/$(database)/documents/conversations/$(id)).data
      );
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(id)).data
        );
      allow update, delete: if isConversationParticipant(
        get(/databases/$(database)/documents/conversations/$(id)).data
      );
    }
  }
}
