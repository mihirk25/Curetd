rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPublicLegalNameFields(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function noPublicLegalNameFields(data) {
      return !hasPublicLegalNameFields(data);
    }

    function noLegalNameAddedOrChanged() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(['firstName', 'lastName'])
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['firstName', 'lastName']);
    }

    function noPublicCuratorEmail(data) {
      return !data.keys().hasAny(['curatorEmail']);
    }

    function conversationParticipant(data) {
      return signedIn()
        && data.keys().hasAny(['participants'])
        && request.auth.uid in data.participants;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if noPublicLegalNameFields(resource.data) || isOwner(userId);
      allow create: if isOwner(userId) && noPublicLegalNameFields(request.resource.data);
      allow update: if isOwner(userId)
        && (noPublicLegalNameFields(request.resource.data) || noLegalNameAddedOrChanged());
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if noPublicCuratorEmail(resource.data) || isOwner(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && noPublicCuratorEmail(request.resource.data);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && noPublicCuratorEmail(request.resource.data);
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{likeId} {
      allow read: if true;
      allow create, update, delete: if isOwner(likeId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid);
    }

    // Unknown clip subcollections are denied; in rules v2 this fallback can also match the top-level clip doc.
    match /clips/{clipId}/{document=**} {
      allow read, write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /conversations/{id} {
      allow read, update, delete: if conversationParticipant(resource.data);
      allow create: if conversationParticipant(request.resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if conversationParticipant(get(/databases/$(database)/documents/conversations/$(id)).data);
      allow create: if conversationParticipant(get(/databases/$(database)/documents/conversations/$(id)).data)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if conversationParticipant(get(/databases/$(database)/documents/conversations/$(id)).data);
    }
  }
}
