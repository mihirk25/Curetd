rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    // Unique handles: public read; create when uid matches.
    // Delete only when the owner no longer claims this handle after the write
    // (rename transaction). Bare delete while users.username still equals {uname}
    // would orphan the registry and enable reclaim/misattribution.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid
        && (
          !existsAfter(userPath(request.auth.uid))
          || !getAfter(userPath(request.auth.uid)).data.keys().hasAny(['username'])
          || getAfter(userPath(request.auth.uid)).data.username != uname
        );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read, write: if request.auth != null;
    }

    match /follows/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id}/messages/{mid} {
      allow read, write: if request.auth != null;
    }
  }
}
