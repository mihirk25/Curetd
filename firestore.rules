rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function participantIn(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    // Same membership (order-independent). Blocks ACL expansion/shrink while
    // still allowing benign reorders from create-if-missing merge paths.
    function sameParticipantSet(before, after) {
      return before.participants is list
        && after.participants is list
        && before.participants.size() == after.participants.size()
        && after.participants.hasAll(before.participants);
    }

    function conversationPath(id) {
      return /databases/$(database)/documents/conversations/$(id);
    }

    function currentConversationParticipant(id) {
      return exists(conversationPath(id))
        && participantIn(get(conversationPath(id)).data);
    }

    function nextConversationParticipant(id) {
      return participantIn(getAfter(conversationPath(id)).data);
    }

    function isMessageSender() {
      return signedIn()
        && resource.data.senderId == request.auth.uid;
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read, write: if request.auth != null;
    }

    match /follows/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id} {
      allow read, delete: if participantIn(resource.data);
      allow create: if participantIn(request.resource.data);
      // Participants are immutable (set-equality). Prevents inviting a third
      // party into a DM to leak history after participant-only reads land.
      allow update: if participantIn(resource.data)
        && sameParticipantSet(resource.data, request.resource.data);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if currentConversationParticipant(id);
      allow create: if nextConversationParticipant(id)
        && request.resource.data.senderId == request.auth.uid;
      // Sender may edit own messages (senderId sticky). Any participant may
      // only flip `read` (mark-as-read). Blocks peer forge/wipe of text.
      allow update: if currentConversationParticipant(id) && (
        (
          isMessageSender()
          && request.resource.data.senderId == resource.data.senderId
        )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if currentConversationParticipant(id) && isMessageSender();
    }
  }
}
