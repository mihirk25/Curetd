rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function noLegalNameFields(data) {
      return !data.keys().hasAny(['firstName', 'lastName']);
    }

    function hasLeakedLegalName(data) {
      return data.keys().hasAny(['firstName', 'lastName']);
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(conversationPath(conversationId))
        && request.auth.uid in get(conversationPath(conversationId)).data.participants;
    }

    function willBeConversationParticipant(conversationId) {
      return signedIn()
        && existsAfter(conversationPath(conversationId))
        && request.auth.uid in getAfter(conversationPath(conversationId)).data.participants;
    }

    function validPrivateUserWrite(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'updatedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0;
    }

    function clipOwner(clipId) {
      return get(/databases/$(database)/documents/clips/$(clipId)).data.userId;
    }

    function notAddingOrChangingCuratorEmail() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(['curatorEmail'])
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['curatorEmail']);
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || !hasLeakedLegalName(resource.data);
      allow create, update: if isOwner(userId)
        && noLegalNameFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if validPrivateUserWrite(userId);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['curatorEmail'])
        && (!request.resource.data.keys().hasAny(['curatorId']) || request.resource.data.curatorId == request.auth.uid);
      allow update: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && notAddingOrChangingCuratorEmail();
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{likeId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && likeId == request.auth.uid;
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || clipOwner(clipId) == request.auth.uid);
    }

    match /clips/{clipId}/reactions/{reactionId} {
      allow read: if true;
      allow write: if false;
    }

    match /clips/{clipId}/{subcollection}/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.followingId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(id);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
      allow update: if isConversationParticipant(id)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(id);
      allow create: if (isConversationParticipant(id) || willBeConversationParticipant(id))
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isConversationParticipant(id);
      allow delete: if false;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.repostedByUid == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
