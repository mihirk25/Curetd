rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // Clip subcollections (likes, comments, …). Emoji reactions path removed from UI — block writes under reactions/*.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && !document.matches("reactions/.*");
    }

    match /savedClips/{id} {
      allow read, write: if request.auth != null;
    }

    // Follow edges are owned by followerId. Updates must keep both endpoints
    // sticky — otherwise any signed-in user can overwrite another user's
    // follow doc by setting followerId to themselves (data loss). Doc id is
    // bound to `${followerId}_${followingId}` so duplicate edges cannot inflate counts.
    match /follows/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['followerId', 'followingId'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId.size() > 0
        && request.resource.data.followerId != request.resource.data.followingId
        && id == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow update: if request.auth != null
        && resource.data.followerId == request.auth.uid
        && request.resource.data.followerId == resource.data.followerId
        && request.resource.data.followingId == resource.data.followingId
        && id == resource.data.followerId + '_' + resource.data.followingId;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }

    match /conversations/{id} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{id}/messages/{mid} {
      allow read, write: if request.auth != null;
    }
  }
}
