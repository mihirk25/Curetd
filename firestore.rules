rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasNoPublicPrivateUserFields(data) {
      return !data.keys().hasAny(['firstName', 'lastName']);
    }

    function publicUserDocHasNoPrivateFields() {
      return !resource.data.keys().hasAny(['firstName', 'lastName']);
    }

    function isClipOwner(clipId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clips/$(clipId))
        && get(/databases/$(database)/documents/clips/$(clipId)).data.userId == request.auth.uid;
    }

    function canReadClip() {
      return !resource.data.keys().hasAny(['curatorEmail']);
    }

    function canWriteClip(data) {
      return signedIn()
        && data.userId == request.auth.uid
        && !data.keys().hasAny(['curatorEmail']);
    }

    function isConversationParticipant(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(id))
        && get(/databases/$(database)/documents/conversations/$(id)).data.participants.hasAny([request.auth.uid]);
    }

    function isConversationParticipantAfter(id) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/conversations/$(id))
        && getAfter(/databases/$(database)/documents/conversations/$(id)).data.participants.hasAny([request.auth.uid]);
    }

    function requestUserIsParticipant() {
      return signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.hasAny([request.auth.uid]);
    }

    // Unique handles: public read; create/delete when the authenticated user matches { uid }.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.uid;
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId) || publicUserDocHasNoPrivateFields();
      allow create, update: if ownsUserDoc(userId)
        && hasNoPublicPrivateUserFields(request.resource.data);
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow read, create, update: if ownsUserDoc(userId);
      allow delete: if false;
    }

    match /clips/{clipId} {
      allow read: if canReadClip() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if canWriteClip(request.resource.data);
      allow update: if canWriteClip(request.resource.data)
        && resource != null
        && resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    match /clips/{clipId}/likes/{userId} {
      allow read: if true;
      allow create, update, delete: if ownsUserDoc(userId);
    }

    match /clips/{clipId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isClipOwner(clipId));
    }

    // Unknown clip subcollections, including removed reactions, are read-only.
    match /clips/{clipId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /savedClips/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /reposts/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.repostedByUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.repostedByUid == request.auth.uid;
    }

    match /topics/{id} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /conversations/{id} {
      allow read: if isConversationParticipant(id);
      allow create: if requestUserIsParticipant();
      allow update: if isConversationParticipant(id) && requestUserIsParticipant();
      allow delete: if isConversationParticipant(id);
    }

    match /conversations/{id}/messages/{mid} {
      allow read: if isConversationParticipant(id);
      allow create: if isConversationParticipantAfter(id)
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isConversationParticipant(id)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if isConversationParticipant(id)
        && resource.data.senderId == request.auth.uid;
    }
  }
}
